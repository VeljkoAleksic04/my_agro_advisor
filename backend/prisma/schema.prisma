datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JedinicaPovrsine {
  A
  HA
  M2
}

enum JedinicaKarence {
  DAN
  NEDELJA
  MESEC
}

enum TipPreparata {
  PESTICID
  DJUBRIVO
}

enum TipPesticida {
  INSEKTICID
  HERBICID
  FUNGICID
}

enum TipDjubriva {
  ZEMLJANO
  FOLIJALNO
  FERTILIGACIONO
}

enum Tezina {
  mg
  G
  KG
  T
}

enum StatusZasadjeneKulture {
  ZASADJENA
  AKTIVNA
  OBRANA
  PROPALA
}

enum StatusBiljke {
  POSADJENA
  RASTE
  OBRANA
  PROPALA
}

enum UlogaKorisnika {
  GOST
  FARMER
}

enum StatusPoruke {
  POSLATA
  PRIMLJENA
  PROCITANA
  NEUSPESNO_SLANJE
}

enum Elementi {
  Mg
  Ca
  S
  Cu
  NH4NO3
  SO4
  Cl
  NATRIJUM_HIPOHLORIT
  LIMUNSKA_KISELINA
  FOSFORNA_KISELINA
  ALUMINIJUM_FOSFID
  ORGANOFOSFATI
  XILEN
  TOLUEN
}

enum VrstaBiljke {
  PSENICA
  KUKURUZ
  JECAM
  OVAS
  RAZ
  SUNCOKRET
  SOJA
  SECERNA_REPA
  KROMPIR
  PARADAJZ
  PAPRIKA
  KRASTAVAC
  KUPUS
  LUK
  BELI_LUK
  SARGAREPA
  SALATA
  TIKVICA
  LUBENICA
  DINJA
}

model Poljoprivrednik {
  id               Int      @id @default(autoincrement())
  ime              String
  prezime          String
  email            String   @unique
  datumRodjenja    DateTime
  username         String   @unique
  password         String
  brojTelefona     String?
  slika            String? 
  parcele          Parcela[]
  sadnje           Sadnja[]
  kreiranDana      DateTime @default(now())
  izmenjenDana     DateTime @updatedAt
  transakcijePoena TransakcijaPoena[]
  ukupnoPoena      Int      @default(0)
  uloga            UlogaKorisnika @default(GOST)
  pokrenuteTeme    TemaForuma[]
  navodnjavanja    Navodnjavanje[]
  reakcijeNaTemu   ReakcijaNaTemu[]
  reakcijeNaPoruku ReakcijaNaPoruku[]
  porukeForuma     PorukaForuma[]

  @@map("poljoprivrednici")
}

model Parcela {
  id            Int      @id @default(autoincrement())
  vlasnikId     Int
  vlasnik       Poljoprivrednik @relation(fields: [vlasnikId], references: [id], onDelete: Cascade)
  naziv         String
  povrsina      Int
  jedinicaMere  JedinicaPovrsine @default(A)
  klasa         Int
  datumUpisa    DateTime @default(now())
  opis          String?
  biljke        Biljka[]
  tretmani      Tretman[]
  sadnje        Sadnja[]
  navodnjavanja Navodnjavanje[]

  @@map("parcele")
}

model Biljka {
  id                         Int      @id @default(autoincrement())
  naziv                      String
  vrsta                      VrstaBiljke
  pocetakSadnje              DateTime
  krajSadnje                 DateTime
  pocetakBerbe               DateTime
  krajBerbe                  DateTime
  preporucenoDjubrivoId      Int?
  preporucenoDjubrivo        Preparat? @relation(fields: [preporucenoDjubrivoId], references: [id])
  preporucenaTemperaturaC    Int
  povrsina                   Int      @default(0)
  datumSadnje                DateTime @default(now())
  status                     StatusBiljke @default(POSADJENA)
  poslednjeZalivanje         DateTime?
  poslednjiTretman           DateTime?
  poslednjaBerba             DateTime?
  parcelaId                  Int
  parcela                    Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  sadnje                     Sadnja[]
  tretmani                   Tretman[]

  // NAPOMENA: ranije je ovde postojao @@unique([parcelaId, vrsta]) koji je
  // sprecavao ponovnu setvu iste vrste na parceli i nakon berbe (jer obrana
  // biljka ostaje u bazi radi istorije). Jedinstvenost se sada proverava u
  // BiljkaService.create() samo medju AKTIVNIM biljkama (status != OBRANA/PROPALA).
  @@map("biljke")
}

model Tretman {
  id            Int      @id @default(autoincrement())
  parcelaId     Int
  parcela       Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  biljkaId      Int?
  biljka        Biljka?  @relation(fields: [biljkaId], references: [id], onDelete: SetNull)
  preparatId    Int
  preparat      Preparat @relation(fields: [preparatId], references: [id], onDelete: Restrict)
  doza          String
  datumTretmana DateTime @default(now())

  @@unique([parcelaId, biljkaId, preparatId, datumTretmana])
  @@map("tretmani")
}

model Preparat {
  id              Int      @id @default(autoincrement())
  tretmani        Tretman[]
  biljkePreporuka Biljka[]
  naziv           String
  proizvodjac     String
  trajanjeKarence Int
  jedinicaKarence JedinicaKarence
  tipPreparata    TipPreparata
  tipPesticida    TipPesticida?
  tipDjubriva     TipDjubriva?
  sastojci        Sastojak[]
  opis            String

  @@map("preparati")
}


model Sastojak {
  id          Int      @id @default(autoincrement())
  preparatId  Int
  preparat    Preparat @relation(fields: [preparatId], references: [id], onDelete: Cascade)
  element     Elementi
  kolicina    Int
  jedinica    Tezina   @default(mg)

  @@unique([preparatId, element])
  @@map("sastojci")
}

model Sadnja {
  id                       Int      @id @default(autoincrement())
  farmerId                 Int
  farmer                   Poljoprivrednik @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  datum                    DateTime @default(now())
  parcelaId                Int
  parcela                  Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  // biljkaId je NAMERNO opciono (nullable): nakon berbe se Biljka trajno
  // brise (stvarno se uklanja veza sa parcelom, ne samo sakriva u UI-ju),
  // pa ovde ostaje null. naziv/vrsta kulture se zato "snapshot"-uju u
  // nazivKulture/vrstaKulture u trenutku sadnje, da istorija/statistika i
  // dalje mogu da prikazu kulturu i nakon sto biljka vise ne postoji.
  biljkaId                 Int?
  biljka                   Biljka?  @relation(fields: [biljkaId], references: [id], onDelete: SetNull)
  nazivKulture             String
  vrstaKulture             VrstaBiljke
  kolicinaPosadjeneKulture Int
  ocekivaniDatumBerbe      DateTime?
  prinos                   Int      @default(0)
  jedinica                 Tezina   @default(KG)
  status                   StatusZasadjeneKulture @default(ZASADJENA)

  @@map("sadnje")
}

model TransakcijaPoena {
  id               Int      @id @default(autoincrement())
  farmerId         Int
  farmer           Poljoprivrednik @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  datumTransakcije DateTime @default(now())
  ostvareniPoeni   Int
  razlog           String

  @@map("transakcije_poena")
}

model TemaForuma {
  id              Int      @id @default(autoincrement())
  naslov          String
  opis            String
  datumKreiranja  DateTime @default(now())
  datumIzmene     DateTime? @updatedAt
  farmerId        Int
  farmer          Poljoprivrednik @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  poruke          PorukaForuma[]
  reakcije        ReakcijaNaTemu[]

  @@map("teme_foruma")
}

model PorukaForuma {
  id             Int      @id @default(autoincrement())
  sadrzaj        String
  datumKreiranja DateTime @default(now())
  datumIzmene    DateTime? @updatedAt
  autorId        Int
  autor          Poljoprivrednik @relation(fields: [autorId], references: [id], onDelete: Cascade)
  temaId         Int
  tema           TemaForuma @relation(fields: [temaId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   PorukaForuma?  @relation("Odgovor", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  odgovori PorukaForuma[] @relation("Odgovor")
  reakcije ReakcijaNaPoruku[]

  @@map("poruke_foruma")
}

model Navodnjavanje {
  id                 Int      @id @default(autoincrement())
  datumNavodnjavanja DateTime @default(now())
  parcelaId          Int?
  parcela            Parcela? @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  farmerId           Int
  farmer             Poljoprivrednik @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  napomena           String

  @@map("navodnjavanja")
}

model ReakcijaNaTemu {
  id            Int      @id @default(autoincrement())
  datumReakcije DateTime @default(now())
  idPost        Int
  post          TemaForuma @relation(fields: [idPost], references: [id], onDelete: Cascade)
  idFarmera     Int
  farmer        Poljoprivrednik @relation(fields: [idFarmera], references: [id], onDelete: Cascade)

  @@unique([idPost, idFarmera])
  @@map("reakcije_na_temu")
}

model ReakcijaNaPoruku {
  id            Int      @id @default(autoincrement())
  datumReakcije DateTime @default(now())
  idFarmera     Int
  farmer        Poljoprivrednik @relation(fields: [idFarmera], references: [id], onDelete: Cascade)
  idMessage     Int
  message       PorukaForuma @relation(fields: [idMessage], references: [id], onDelete: Cascade)

  @@unique([idMessage, idFarmera])
  @@map("reakcije_na_poruku")
}
