datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Ignorisi ovo slobodno
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum JedinicaPovrsine {
  A
  HA
  M2
}

enum JedinicaKarence {
  DAN
  NEDELJA
  MESEC
}

enum TipPreparata {
  PESTICID
  DJUBRIVO
}

enum TipPesticida {
  INSEKTICID
  HERBICID
  FUNGICID
}

enum TipDjubriva {
  ZEMLJANO
  FOLIJALNO
  FERTILIGACIONO
}

enum Tezina {
  mg
  G
  KG
  T
}

enum StatusZasadjeneKulture {
  ZASADJENA
  AKTIVNA
  OBRANA
  PROPALA
}

enum UlogaKorisnika {
  GOST
  FARMER
}

enum StatusPoruke {
  POSLATA
  PRIMLJENA
  PROCITANA
  NEUSPESNO_SLANJE
}

enum Elementi {
  Mg
  Ca
  S
  Cu
  NH4NO3
  SO4
  Cl
  Natrijum_hipohlorih
  Limunska_kiselina
  Fosforna_kiselina
  Aluminijum_fosfid
  Organofosfati
  Xilen
  Toulen
}

model Poljoprivrednik {
  id Int @id @default(autoincrement())
  ime String
  orezime String
  email String @unique
  datumRodjenja DateTime
  username String @unique
  password String
  parcele Parcela[]
  sadnje Sadnja[]
  kreiranDana DateTime @default(now())
  izmenjenDana DateTime @updatedAt
  transakcijePoena TransakcijaPoena[]
  ukupnoPoena Int
  uloga UlogaKorisnika @default(GOST)
  pokrenuteTeme TemaForuma[]
  navodnjavanja Navodnjavanje[]
  reakcijeNaTemu ReakcijaNaTemu[]
  reakcijeNaPoruku ReakcijaNaPoruku[]
}

model Parcela {
  id Int @id @default(autoincrement())
  vlasnikId Int
  vlasnik Poljoprivrednik @relation(fields: [vlasnikId], references: [id])
  naziv String
  povrsina Int
  jedinicaMere JedinicaPovrsine @default(A)
  klasa Int
  datumUpisa DateTime @default(now())
  biljke Biljka[]
  tretmani Tretman[]
  sadnje Sadnja[]
  navodnjavanja Navodnjavanje[]
}


model Biljka {
  id Int @id @default(autoincrement())
  naziv String
  vrsta String @unique
  pocetakSadnje DateTime
  krajSadnje DateTime
  pocetakBerbe DateTime
  krajBerbe DateTime
  preporucenoDjubrivoId Int
  trenutnoPreporucenoDubrivo Tretman[]
  preporicenaTemperaturaC Int
  parcelaId Int
  parcela Parcela @relation(fields: [parcelaId], references: [id])
  sadnje Sadnja[]
}

model Tretman {
  id Int @id @default(autoincrement())
  parcelaId Int
  parcela Parcela @relation(fields: [parcelaId], references: [id])
  biljkaId Int?
  biljka Biljka? @relation(fields: [biljkaId], references: [id])
  preparatId Int
  preparat Preparat @relation(fields: [preparatId], references: [id])
  doza String
  datumTretmana DateTime @default(now())

  @@unique([parcelaId, biljkaId, preparatId, datumTretmana])
}

model Preparat {
  id Int @id @default(autoincrement())
  tretmani Tretman[]
  naziv String
  proizvodjac String
  trajanjeKarence Int
  jedinicaKarence JedinicaKarence
  tipPreparata TipPreparata
  tipPesticida TipPesticida?
  tipDjubriva TipDjubriva?
  sastojci Sastojak[] // Ovde se NPK i Magnezijum kombinuju
  opis String
}

model Sastojak { // Ovde se dobija NPK i Magnezijum ili samo N, pa magnezijum
  id Int @id @default(autoincrement())
  preparatId Int
  preparat Preparat @relation(fields: [preparatId], references: [id])
  elementId Int
  elementi Element @relation(fields: [elementId], references: [id])
  kolicina Int
  jedinica Tezina @default(mg)

  @@unique([preparatId, elementId])
}

model Element {
  id Int @id @default(autoincrement())
  element Elementi
  sastojci Sastojak[]
}

model Sadnja {
  id Int @id @default(autoincrement())
  farmerId Int
  farmer Poljoprivrednik @relation(fields: [farmerId], references: [id])
  datum DateTime @default(now())
  parcelaId Int
  parcela Parcela @relation(fields: [parcelaId], references: [id])
  biljkaId Int
  kultura Biljka @relation(fields: [biljkaId], references: [id])
  kolicinaPosadjeneKulture Int
  ocekivaniDatumBerbe DateTime
  prinos Int @default(0)
  jedinica Tezina @default(KG)
  status StatusZasadjeneKulture @default(ZASADJENA)
}

model TransakcijaPoena {
  id Int @id @default(autoincrement())
  farmerId Int
  farmer Poljoprivrednik @relation(fields: [farmerId], references: [id])
  datumTransakcije DateTime @default(now())
  ostvareniPoeni Int
  razlog String
}

model TemaForuma {
  id Int @id @default(autoincrement())
  naslov String
  opis String
  datumKreiranja DateTime
  datumIzmene DateTime?
  farmerId Int
  farmer Poljoprivrednik @relation(fields: [farmerId], references: [id])
  poruke PorukaForuma[]
  reakcije ReakcijaNaTemu[]
}

model PorukaForuma {
  id              Int      @id @default(autoincrement())
  Sadrzaj         String
  DatumKreiranja  DateTime @default(now())
  DatumIzmene     DateTime?
  autorId         Int
  temaId          Int

  tema            TemaForuma @relation(fields: [temaId], references: [id])
  
  parentId        Int?
  parent          PorukaForuma? @relation("Odgovor", fields: [parentId], references: [id])
  odgovori        PorukaForuma[] @relation("Odgovor") 
  reakcije        ReakcijaNaPoruku[]
}

model Navodnjavanje {
  id Int @id @default(autoincrement())
  datumNavodnjavanja DateTime @default(now())
  parcelaId Int?
  parcela Parcela? @relation(fields: [parcelaId], references: [id])
  farmerId Int
  farmer Poljoprivrednik @relation(fields: [farmerId], references: [id])
  napomena String
}

model ReakcijaNaTemu {
  id Int @id @default(autoincrement())
  datumReakcije DateTime @default(now())
  idPost Int
  post TemaForuma @relation(fields: [idPost], references: [id])
  idFarmera Int
  farmer Poljoprivrednik @relation(fields: [idFarmera], references: [id])
}

model ReakcijaNaPoruku {
  id Int @id @default(autoincrement())
  datumReakcije DateTime @default(now())
  idFarmera Int
  farmer Poljoprivrednik @relation(fields: [idFarmera], references: [id])
  idMessage Int
  message PorukaForuma @relation(fields: [idMessage], references: [id])
}