datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Ignorisi ovo slobodno
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum JedinicaPovrsine {
  A
  HA
  M2
}

enum JedinicaKarence {
  DAN
  NEDELJA
  MESEC
}

enum TipPreparata {
  PESTICID
  DJUBRIVO
}

enum TipPesticida {
  INSEKTICID
  HERBICID
  FUNGICID
}

enum TipDjubriva {
  ZEMLJANO
  FOLIJALNO
  FERTILIGACIONO
}

enum Tezina {
  mg
  G
  KG
  T
}

enum StatusZasadjeneKulture {
  ZASADJENA
  AKTIVNA
  OBRANA
  PROPALA
}

enum UlogaKorisnika {
  GOST
  FARMER
}

enum StatusPoruke {
  POSLATA
  PRIMLJENA
  PROCITANA
  NEUSPESNO_SLANJE
}

enum Elementi {
  Mg
  Ca
  S
  Cu
  NH4NO3
  SO4
  Cl
  Natrijum_hipohlorih
  Limunska_kiselina
  Fosforna_kiselina
  Aluminijum_fosfid
  Organofosfati
  Xilen
  Toulen
}

model Poljoprivrednik {
  id Int @id @default(autoincrement())
  Ime String
  Prezime String
  email String @unique
  DatumRodjenja DateTime
  username String @unique
  password String
  parcele Parcela[]
  sadnje Sadnja[]
  kreiranDana DateTime @default(now())
  izmenjenDana DateTime @updatedAt
  transakcijePoena TransakcijaPoena[]
  UkupnoPoena Int
  Uloga UlogaKorisnika @default(GOST)
  pokrenuteTeme TemaForuma[]
}

model Parcela {
  id Int @id @default(autoincrement())
  vlasnikId Int
  vlasnik Poljoprivrednik @relation(fields: [vlasnikId], references: [id])
  Naziv String
  Povrsina Int
  JedinicaMere JedinicaPovrsine @default(A)
  Klasa Int
  DatumUpisa DateTime @default(now())
  biljke Biljka[]
  tretmani Tretman[]
  sadnje Sadnja[]
  navodnjavanja Navodnjavanje[]
}


model Biljka {
  id Int @id @default(autoincrement())
  naziv String
  vrsta String @unique
  pocetakSadnje DateTime
  krajSadnje DateTime
  pocetakBerbe DateTime
  krajBerbe DateTime
  idPreporucenogDjubriva Int
  trenutnoPreporucenoDubrivo Tretman[]
  preporicenaTemperaturaC Int
  parcelaId Int
  parcela Parcela @relation(fields: [parcelaId], references: [id])
  sadnje Sadnja[]
}

model Tretman {
  id Int @id @default(autoincrement())
  idParcele Int
  parcela Parcela @relation(fields: [idParcele], references: [id])
  idBiljke Int?
  biljka Biljka? @relation(fields: [idBiljke], references: [id])
  idPreparata Int
  preparat Preparat @relation(fields: [idPreparata], references: [id])
  Doza String
  DatumTretmana DateTime @default(now())

  @@unique([idParcele, idBiljke, idPreparata, DatumTretmana])
}

model Preparat {
  id Int @id @default(autoincrement())
  tretmani Tretman[]
  Naziv String
  Proizvodjac String
  TrajanjeKarence Int
  JedinicaKarence JedinicaKarence
  TipPreparata TipPreparata
  TipPesticida TipPesticida?
  TipDjubriva TipDjubriva?
  sastojci Sastojak[] // Ovde se NPK i Magnezijum kombinuju
}

model Sastojak { // Ovde se dobija NPK i Magnezijum ili samo N, pa magnezijum
  id Int @id @default(autoincrement())
  idPreparata Int
  preparat Preparat @relation(fields: [idPreparata], references: [id])
  idElementa Int
  elementi Element @relation(fields: [idElementa], references: [id])
  Kolicina Int
  Jedinica Tezina @default(mg)

  @@unique([idPreparata, idElementa])
}

model Element {
  id Int @id @default(autoincrement())
  element Elementi
  sastojci Sastojak[]
}

model Sadnja {
  id Int @id @default(autoincrement())
  idFarmera Int
  farmer Poljoprivrednik @relation(fields: [idFarmera], references: [id])
  Datum DateTime @default(now())
  idParcele Int
  parcela Parcela @relation(fields: [idParcele], references: [id])
  idBiljke Int
  kultura Biljka @relation(fields: [idBiljke], references: [id])
  KolicinaPosadjeneKulture Int
  OcekivaniDatumBerbe DateTime
  Prinos Int @default(0)
  Jedinica Tezina @default(KG)
  Status StatusZasadjeneKulture @default(ZASADJENA)
}

model TransakcijaPoena {
  id Int @id @default(autoincrement())
  idFarmera Int
  farmer Poljoprivrednik @relation(fields: [idFarmera], references: [id])
  DatumTransakcije DateTime @default(now())
  OstvareniPoeni Int
  Razlog String
}

model TemaForuma {
  id Int @id @default(autoincrement())
  Naslov String
  Opis String
  DatumKreiranja DateTime
  DatumIzmene DateTime?
  farmerId Int
  farmer Poljoprivrednik @relation(fields: [farmerId], references: [id])
  poruke PorukaForuma[]
  reakcije Reakcija[]
}

model PorukaForuma {
  id              Int      @id @default(autoincrement())
  Sadrzaj         String
  DatumKreiranja  DateTime @default(now())
  DatumIzmene     DateTime?
  autorId         Int
  temaId          Int

  tema            TemaForuma @relation(fields: [temaId], references: [id])
  
  parentId        Int?
  parent          PorukaForuma? @relation("Odgovor", fields: [parentId], references: [id])
  odgovori        PorukaForuma[] @relation("Odgovor") 
  reakcije        Reakcija[]
}

model Navodnjavanje {
  id Int @id @default(autoincrement())
  DatumNavodnjavanja DateTime @default(now())
  idParcele Int
  parcela Parcela? @relation(fields: [idParcele], references: [id])
}

model Reakcija {
  id Int @id @default(autoincrement())
  DatumReakcije DateTime @default(now())
  idParentPost Int
  ParentPost TemaForuma @relation(fields: [idParentPost], references: [id])
  idParentMessage Int?
  ParentMessage PorukaForuma? @relation(fields: [idParentMessage], references: [id])
}